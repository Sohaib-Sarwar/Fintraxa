# Fintraxa — environment
#
# Copy to `.env.local` for local development and fill in real values.
# `.env.local` is gitignored; `.env.example` is not — keep placeholders here.
#
# Everything VITE_-prefixed is inlined into the client bundle at build time and
# is therefore PUBLIC. Never put a Supabase service-role key, a database
# password or any other secret in this file or in the Vercel project's
# VITE_ variables.

# ── Supabase ──────────────────────────────────────────────────────────────
# Project → Settings → API. The publishable key is safe to ship; RLS is what
# enforces access.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# ── Market data ───────────────────────────────────────────────────────────
# PK Finance Unified Service — PSX and MUFAP data, published as static JSON.
# Optional: the app falls back to this exact value when unset. Override it to
# point at a fork or a local build of the service.
# VITE_API_BASE_URL=https://sohaib-sarwar.github.io/PSX-MUFAP-MicroService/api
